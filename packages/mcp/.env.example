# Where the data comes from. Defaults are GBIF's public endpoints.
GBIF_GRAPHQL_URL=https://graphql.gbif.org/graphql
GBIF_API_URL=https://api.gbif.org

# Public address of this deployment. On Vercel it is derived from the request, set this to override.
# PUBLIC_BASE_URL=https://gbif-mcp.example.com

# Canvas storage. Without these the canvas lives in memory, which only works on a long-running process
# (npm run dev). On Vercel, add an Upstash Redis store from the Marketplace; it sets these variables.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
