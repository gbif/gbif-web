# Endpoint overlay for load testing — repoints every PUBLIC_* upstream at the local mock proxy
# (loadtest/mock-server.mjs on :4010). Copy this to ../.env.loadtest (repo root) before BUILDING:
#
#     cp loadtest/.env.loadtest ../.env.loadtest
#     npx vite build --config gbif/vite.config.ts --mode loadtest --ssrManifest
#     npx vite build --config gbif/vite.config.ts --mode loadtest --outDir ./dist/gbif/server --ssr ./src/gbif/entry.server.tsx
#
# IMPORTANT: Vite statically replaces import.meta.env.PUBLIC_* at BUILD time (envPrefix: 'PUBLIC_'
# in gbif/vite.config.ts), so these must be set before building, not just before `npm start`.
# `--mode loadtest` is what makes Vite load the root `.env.loadtest` overlay (the default
# `production` build mode would NOT). It still keeps prod characteristics (import.meta.env.PROD).
# The root `.env.loadtest` takes precedence over `.env`, so secrets/API keys still come from `.env`.

PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4010/graphql
PUBLIC_TRANSLATIONS_ENTRY_ENDPOINT=http://localhost:4010/translations
PUBLIC_WEB_UTILS=http://localhost:4010/unstable-api
PUBLIC_FORMS_ENDPOINT=http://localhost:4010/forms
PUBLIC_CONTENT_SEARCH=http://localhost:4010/content
PUBLIC_API=http://localhost:4010/api
PUBLIC_API_V1=http://localhost:4010/api/v1
PUBLIC_API_V2=http://localhost:4010/api/v2
PUBLIC_TILE_API=http://localhost:4010/tile

# Keep the SSR build in production mode characteristics
NODE_ENV=production
