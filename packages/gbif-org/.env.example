# gbif-org config. Copy to .env (or .env.local, which wins). Values below are public production
# endpoints: enough to run locally. PUBLIC_* values are inlined into the browser bundle at build
# time, so they are never secret. Everything else stays on the server.

# --- Server ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DEBUG_LEVEL=WARN # ERROR | WARN | INFO | DEBUG
# LOGS_DIRECTORY=logs

# --- Server secrets (sign-in, accounts) ---
# Any non-empty value boots the server; sign-in needs the real ones.
JWT_SECRET=CHANGE_ME # signs the session cookie; required or the server crashes at start
GRAPHQL_JWT_SECRET=CHANGE_ME # signs tokens for graphql-api; must match its jwtSecret
ENCRYPTION_KEY=CHANGE_ME
APP_KEY=CHANGE_ME # this app's identity towards the GBIF registry; not secret
APP_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
ORCID_CLIENT_ID=CHANGE_ME
ORCID_CLIENT_SECRET=CHANGE_ME
DOMAIN=http://localhost:3000 # OAuth callback origin
REGISTRY_API_V1=https://registry-api.gbif.org # user accounts
USE_SECURE_COOKIE=false # true in deployments (HTTPS only)

# --- Data services ---
PUBLIC_GRAPHQL_ENDPOINT=https://graphql.gbif.org/graphql # local: http://localhost:4123/graphql
PUBLIC_WEB_UTILS=https://graphql.gbif.org/unstable-api # REST helpers on graphql-api
PUBLIC_FORMS_ENDPOINT=https://graphql.gbif.org/forms
PUBLIC_FEEDBACK_ENDPOINT=https://graphql.gbif.org/forms
PUBLIC_TRANSLATIONS_ENTRY_ENDPOINT=https://react-components.gbif.org/lib/translations # local: http://localhost:5002
PUBLIC_CONTENT_SEARCH=https://hp-search.gbif.org/content
PUBLIC_API=https://api.gbif.org
PUBLIC_API_V1=https://api.gbif.org/v1
PUBLIC_API_V2=https://api.gbif.org/v2
PUBLIC_TILE_API=https://tile.gbif.org
PUBLIC_ANALYTICS_FILES_URL=https://analytics-files.gbif.org
# Optional split when server and browser must reach a service by different URLs (e.g. internal
# hostnames on the server). Each falls back to the value above.
# PUBLIC_GRAPHQL_ENDPOINT_SERVER=
# PUBLIC_GRAPHQL_ENDPOINT_CLIENT=
# PUBLIC_FORMS_ENDPOINT_SERVER=
# PUBLIC_FORMS_ENDPOINT_CLIENT=
# PUBLIC_TRANSLATIONS_ENTRY_ENDPOINT_SERVER=
# PUBLIC_TRANSLATIONS_ENTRY_ENDPOINT_CLIENT=

# --- Linked websites ---
PUBLIC_GBIF_ORG=https://www.gbif.org
PUBLIC_TOOLS_GBIF_ORG=https://tools.gbif.org
PUBLIC_REGISTRY=https://registry.gbif.org
PUBLIC_GRSCICOLL=https://scientific-collections.gbif.org
PUBLIC_CHECKLIST_BANK_WEBSITE=https://www.checklistbank.org
PUBLIC_STATUS_PAGE_URL=https://status.gbif.org # health icon in the header
PUBLIC_FEEDBACK_GITHUB_REPO=https://github.com/gbif/portal-feedback

# --- Checklists (backbone d7dddbf4…, Catalogue of Life 7ddf754f…) ---
PUBLIC_DEFAULT_CHECKLIST_KEY=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c # when none is specified
PUBLIC_SUPPORTED_CHECKLISTS=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c,7ddf754f-d193-4cc9-b351-99906754a03b # selectable in the UI
PUBLIC_CHECKLIST_KEY_FOR_CLUSTERING=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c # used to build occurrence clusters
PUBLIC_COL_CHECKLIST_KEY=7ddf754f-d193-4cc9-b351-99906754a03b # links to the COL website, not ChecklistBank
PUBLIC_CLASSIC_BACKBONE_KEY=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c # labels downloads from before multi-checklist support
PUBLIC_SUPPORTED_CHECKLISTS_FOR_DOWNLOAD=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c,7ddf754f-d193-4cc9-b351-99906754a03b # accepted by the download API
PUBLIC_DEFAULT_VISIBLE_CHECKLISTS_FOR_DOWNLOAD=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c,7ddf754f-d193-4cc9-b351-99906754a03b # shown by default; portal links can reveal others

# --- Registry keys with special handling ---
PUBLIC_KEYS_OBIS_NODE=ba0670b9-4186-41e6-8e70-f9cb3065551a
PUBLIC_KEYS_TAIWAN_PARTICIPANT=239
# PUBLIC_ISSG_PUBLISHER_KEY=cdef28b1-db4e-4c58-aa71-3c5238c2d0b5 # GRIIS publisher; this is the default

# --- Site behaviour and feature flags ---
PUBLIC_ENABLED_LANGUAGES=en,es,fr,ar,da # dev-only test locales: nonsense, rtltest, danglish
PUBLIC_TEST_SITE=false # true shows a "test site" banner and test-environment links
PUBLIC_DEFAULT_ENABLE_MAP_CHARTS=true
PUBLIC_ENABLE_SAMPLING_EVENT_BROWSER=enabled
# PUBLIC_PLAUSIBLE_DOMAIN=gbif.org # analytics; unset = none
# PUBLIC_DEBUGGING=true # stack traces in error boundaries
# PUBLIC_WIDGET_FRAME_ANCESTORS=* # origins allowed to embed widgets in iframes

# --- Admin (gbif.org/backstage) ---
# ADMIN_USERS=some.gbif.username,another # comma-separated GBIF usernames
# ADMIN_GRAPHQL_NODES=http://localhost:4123 # comma-separated graphql-api instances to fan settings out to
# ADMIN_ES_API_NODES=http://localhost:4001 # comma-separated es-api instances
