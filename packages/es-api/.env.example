# es-api config (YAML). Copy to .env. Each index section is optional: leave one out and its
# routes are not mounted. Hosts are reachable only on the GBIF VPN.

# --- Secrets ---
apiKey: CHANGE_ME # callers (graphql-api `apiEsKey`) must send this key
graphqlJwtSecret: CHANGE_ME # same as graphql-api; verifies admin users' JWTs for /admin
adminUsers: [] # GBIF usernames allowed to change settings via POST /admin/settings

# --- Server ---
port: 4001
environment: dev # dev | staging | prod; tags log lines
debugLevel: WARN # ERROR | WARN | INFO | DEBUG
debug: false # true disables the response cache

# --- Upstream ---
apiv1: https://api.gbif.org/v1 # translates occurrence/event predicates to ES queries (toesquery)
defaultChecklist: d7dddbf4-2cf0-4f39-9b2a-bb099caae36c # backbone; taxonomy used when none is requested

# --- Elasticsearch indices ---
# Shared fields: requestTimeout (ms), maxRetries, maxResultWindow (max from + size).
# `index` defaults to the section name.

occurrence:
  hosts: [http://es-occurrence-1:9200, http://es-occurrence-2:9200]
  index: occurrence
  requestTimeout: 60000
  maxRetries: 3
  maxResultWindow: 100000

dataset:
  hosts: [http://es-core-1:9200]
  requestTimeout: 30000
  maxRetries: 3
  maxResultWindow: 100000

content: # CMS content and literature
  hosts: [http://es-core-1:9200]
  requestTimeout: 10000
  maxRetries: 2
  maxResultWindow: 100000

event:
  hosts: [http://es-event-1:9200]
  index: event
  requestTimeout: 60000
  maxRetries: 3
  maxResultWindow: 100000

eventOccurrence:
  hosts: [http://es-event-1:9200]
  index: event
  requestTimeout: 60000
  maxRetries: 3
  maxResultWindow: 100000

# --- Load shedding (optional) ---
# In front of the FIFO occurrence queue, reject new requests by `x-client-priority` (1-100, lower is
# more important) while the backlog is deep. Queued requests are never evicted. Omit to disable.
queue:
  defaultPriority: 100 # when the header is missing or invalid
  shedBands: # rejected (429) if over any band
    - queueAbove: 100
      maxPriority: 50
    - queueAbove: 200
      maxPriority: 30
