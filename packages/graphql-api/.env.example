# graphql-api config (YAML). Copy to .env. Read at import by src/config.js, tests included.
# CLI args (--port, --apiEs, --origin, --translations) and env vars (PORT, apiEs, origin,
# translations) override it. Values below are public production endpoints: enough to run locally
# without the VPN. Fields backed by es-api need the real apiEsKey. So occurrence search will not work without.

# --- Server ---
port: 4123
origin: http://localhost:4123 # this server's public URL; used in links it generates
environment: dev # dev | test | prod; tags logs, prefixes non-prod form emails
debugLevel: WARN # ERROR | WARN | INFO | DEBUG
debug: false # true disables HTTP caching

# --- Secrets (all CHANGE_ME values) ---
apiEsKey: CHANGE_ME # must match es-api `apiKey`
appKey: CHANGE_ME # this app's identity towards the GBIF registry; not secret
appSecret: CHANGE_ME # pairs with appKey; authenticates against the registry
jwtSecret: CHANGE_ME # verifies JWTs gbif.org issues (gbif-org JWT secret for GraphQL)
encryptionKey: CHANGE_ME # exactly 32 characters; encrypts values round-tripped through clients
thumborSecurityKey: CHANGE_ME # signs image URLs; wrong key = images return 400
downloadMachineDescriptionSecret: CHANGE_ME # encodes download machineDescriptions
localContextApiKey: CHANGE_ME
maptilerApiKey: CHANGE_ME
cites:
  api: http://api.speciesplus.net/api/v1/taxon_concepts.json
  token: CHANGE_ME

# --- GBIF services ---
apiv1: https://api.gbif.org/v1
apiv2: https://api.gbif.org/v2
apiEs: https://hp-search.gbif.org/ # es-api; http://localhost:4001 for a local one
translations: https://react-components.gbif.org/lib/translations # react-components build output
thumbor: https://api.gbif.org/v1/image
occurrenceImageCache: https://api.gbif.org/v1/image/cache
sourceArchiveEndpoint: https://source-archive.gbif.org
blast:
  url: http://blast.gbif.org
statusPage: http://status.gbif.org
gbifLinkTargetOrigin: https://www.gbif.org # site that generated links point to

# --- Registry keys ---
gbifBackboneUUID: d7dddbf4-2cf0-4f39-9b2a-bb099caae36c
colUUID: 7ddf754f-d193-4cc9-b351-99906754a03b
defaultChecklist: d7dddbf4-2cf0-4f39-9b2a-bb099caae36c # backbone; COL is colUUID
participantNodeManagersCommitteeNodeKey: 7f48e0c8-5c96-49ec-b972-30748e339115

# --- External services ---
checklistBank: https://api.checklistbank.org
wikidata:
  instance: https://www.wikidata.org
  sparqlEndpoint: https://query.wikidata.org/sparql
orcid:
  pubApi: https://pub.orcid.org/v2.0
viaf:
  api: http://viaf.org/viaf/

# --- Forms: GitHub issues and email ---
github: # GitHub App that files form submissions as issues; off = forms fail
  enabled: false
  appId: CHANGE_ME
  installationId: CHANGE_ME
  certificate: CHANGE_ME # the app's private key; secret
hostedPortals: { owner: gbif, repository: hosted-portal-programme }
mdt: { owner: gbif, repository: metabarcoding-data-programme }
feedback: { owner: gbif, repository: portal-feedback }
suggestDataset: { owner: gbif, repository: data-mobilization }
downloadUsage: # download-usage form, sent by SMTP
  host: smtp.example.org
  port: 25
  sender: portal@example.org
  recipient: someone@example.org

# --- Operations ---
healthUpdateFrequency:
  enums: 900000 # ms between enum refreshes from apiv1
adminUsers: [] # GBIF usernames allowed into /admin (gbif.org/backstage)

# Per-upstream bulkheads (src/requestPools.ts): a slow upstream cannot stall the whole process.
#   concurrency: max in-flight per pool, process-wide. Omit, 0 or "unbounded" = no limit.
#   perRequestConcurrency: max in-flight per GraphQL request.
#   maxQueueDepth: max waiting for a slot; beyond it, 503. Omit = unbounded.
#   timeoutMs: total budget per request (queue wait + wire).
#   maxSockets: per origin.
# Pools: occurrence (es-api), taxon (apiv2), default (everything else).
requestPools:
  occurrence:
    concurrency: 100
    perRequestConcurrency: 10
    maxQueueDepth: 500
    timeoutMs: 30000
    maxSockets: 150
  taxon:
    concurrency: 100
    perRequestConcurrency: 10
    maxQueueDepth: 500
    timeoutMs: 30000
    maxSockets: 150
  default:
    timeoutMs: 30000
    maxSockets: 256

# Overload guard (src/overloadGuard.ts): fast 503 before parsing when the process is saturated.
# Never guards /health, which reports event-loop delay and heap so thresholds can be tuned first.
overloadProtection:
  enabled: false
  maxEventLoopDelayMs: 70 # healthy loop is under 10
  maxHeapUsedFraction: 0.85
  # maxInFlight: 2000 # hard backstop, size to the instance
  guardedPaths: [/graphql]
  retryAfterSeconds: 1
